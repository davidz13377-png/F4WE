FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates ffmpeg git python3 python3-pip \
  && python3 -m pip install --break-system-packages --no-cache-dir -U "yt-dlp[default]" "bgutil-ytdlp-pot-provider==2.0.0" \
  && git clone --depth 1 --branch 2.0.0 https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git /opt/bgutil-ytdlp-pot-provider \
  && cd /opt/bgutil-ytdlp-pot-provider/server \
  && npm ci \
  && npx tsc \
  && rm -rf /opt/bgutil-ytdlp-pot-provider/.git \
  && chown -R node:node /opt/bgutil-ytdlp-pot-provider \
  && rm -rf /var/lib/apt/lists/*

ENV YT_DLP_POT_PROVIDER_HOME=/opt/bgutil-ytdlp-pot-provider/server

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/bot/package.json apps/bot/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY patches patches
RUN npm ci --include=dev

COPY apps/api/prisma apps/api/prisma
COPY apps/bot apps/bot
RUN npm --workspace @music-box/api run db:generate \
  && npm --workspace @music-box/bot run build \
  && chown -R node:node /app

USER node
CMD ["sh", "-c", "npm --workspace @music-box/api run db:deploy && npm --workspace @music-box/bot run start"]

FROM node:20-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates ffmpeg python3 python3-pip \
  && python3 -m pip install --break-system-packages --no-cache-dir -U "yt-dlp[default]" \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/bot/package.json apps/bot/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY patches patches
RUN npm ci --include=dev

COPY apps/api/prisma apps/api/prisma
COPY apps/bot apps/bot
RUN npm --workspace @music-box/api run db:generate \
  && npm --workspace @music-box/bot run build \
  && chown -R node:node /app

USER node
CMD ["sh", "-c", "npm --workspace @music-box/api run db:deploy && npm --workspace @music-box/bot run start"]

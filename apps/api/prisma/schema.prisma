generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rank {
  Access
  Moderator
  Admin
  Developer
}

enum ReviewStatus {
  Pending
  Processing
  Accepted
  Rejected
  Fixed
}

model User {
  id                      String               @id @db.VarChar(32)
  username                String               @unique @db.VarChar(32)
  passwordHash            String
  sessionVersion          Int                  @default(0)
  rank                    Rank                 @default(Access)
  isOwner                 Boolean              @default(false)
  profilePicture          String?
  bannerUrl               String?
  shareListening          Boolean              @default(false)
  coins                   Int                  @default(0)
  rewardSeconds           Int                  @default(0)
  animatedProfileUnlocked Boolean              @default(false)
  animatedBannerUnlocked  Boolean              @default(false)
  activeProfileDesignId   String?
  registrationDate        DateTime             @default(now())
  accessKeyUsed           String               @db.VarChar(64)
  accessKey               AccessKey            @relation(fields: [accessKeyUsed], references: [key])
  uploadedMusic           Music[]              @relation("Uploader")
  albums                  Album[]
  favorites               Favorite[]
  musicPlays              MusicPlay[]
  savedAlbums             SavedAlbum[]
  musicRequests           MusicRequest[]
  bugReports              BugReport[]
  updateIdeas             UpdateIdea[]
  updatePosts             UpdatePost[]
  notifications           Notification[]
  rankChanges             UserRanksHistory[]   @relation("ChangedUser")
  rankChangesMade         UserRanksHistory[]   @relation("ChangedBy")
  sentFriendRequests      FriendRequest[]      @relation("SentFriendRequests")
  receivedFriendRequests  FriendRequest[]      @relation("ReceivedFriendRequests")
  friendships             Friendship[]         @relation("FriendshipOwner")
  friendedBy              Friendship[]         @relation("FriendshipTarget")
  activeProfileDesign     ProfileDesign?       @relation("ActiveProfileDesign", fields: [activeProfileDesignId], references: [id], onDelete: SetNull)
  ownedProfileDesigns     OwnedProfileDesign[]
  createdProfileDesigns   ProfileDesign[]      @relation("ProfileDesignCreator")
  coinTransactions        CoinTransaction[]    @relation("CoinOwner")
  coinTransactionsMade    CoinTransaction[]    @relation("CoinActor")
  rewardInvites           RewardInvite[]
  playlistCollaborations  PlaylistCollaborator[]
  pushTokens              PushToken[]
}

model AccessKey {
  key                String        @id @db.VarChar(64)
  used               Boolean       @default(false)
  usageLimit         Int           @default(1)
  usedCount          Int           @default(0)
  createdByDiscordId String
  createdDate        DateTime      @default(now())
  usedDate           DateTime?
  users              User[]
  rewardInvite       RewardInvite?
}

model Music {
  id           String      @id @default(cuid())
  title        String
  artist       String?
  filePath     String
  mimeType     String      @default("audio/mpeg")
  duration     Int?
  artworkUrl   String?
  lyrics       String?
  lyricsSynced Boolean     @default(false)
  uploaderId   String?     @db.VarChar(32)
  uploadDate   DateTime    @default(now())
  releaseDate  DateTime?
  normalizedTitle  String  @default("")
  normalizedArtist String  @default("")
  uploader     User?       @relation("Uploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  albums       AlbumSong[]
  favorites    Favorite[]
  plays        MusicPlay[]

  @@index([normalizedTitle, normalizedArtist])
}

model MusicPlay {
  id              String    @id @default(cuid())
  userId          String    @db.VarChar(32)
  musicId         String
  playedAt        DateTime  @default(now())
  listenedSeconds Int       @default(0)
  lastHeartbeatAt DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  music           Music     @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([musicId, playedAt])
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String   @db.VarChar(32)
  receiverId String   @db.VarChar(32)
  createdAt  DateTime @default(now())
  sender     User     @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, createdAt])
}

model Friendship {
  userId    String   @db.VarChar(32)
  friendId  String   @db.VarChar(32)
  createdAt DateTime @default(now())
  user      User     @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipTarget", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
}

model Album {
  id              String       @id @default(cuid())
  name            String
  description     String?
  artworkUrl      String?
  creatorId       String       @db.VarChar(32)
  creationDate    DateTime     @default(now())
  isPublic        Boolean      @default(false)
  isStaffPlaylist Boolean      @default(false)
  cachedTrackCount Int         @default(0)
  cachedDuration   Int         @default(0)
  creator         User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  songs           AlbumSong[]
  savedBy         SavedAlbum[]
  collaborators   PlaylistCollaborator[]
}

model PlaylistCollaborator {
  albumId  String
  userId   String   @db.VarChar(32)
  addedAt  DateTime @default(now())
  album    Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([albumId, userId])
  @@index([userId, addedAt])
}

model AlbumSong {
  albumId String
  musicId String
  order   Int    @default(0)
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  music   Music  @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@id([albumId, musicId])
}

model Favorite {
  userId    String   @db.VarChar(32)
  musicId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  music     Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@id([userId, musicId])
}

model SavedAlbum {
  userId    String   @db.VarChar(32)
  albumId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
}

model MusicRequest {
  id              String       @id @default(cuid())
  userId          String       @db.VarChar(32)
  songsRequested  String
  sourceUrl       String?
  requestedTitle  String?
  requestedArtist String?
  importStartedAt DateTime?
  importedMusicId String?
  status          ReviewStatus @default(Pending)
  rejectionReason String?
  requestDate     DateTime     @default(now())
  processedDate   DateTime?
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BugReport {
  id            String       @id @default(cuid())
  userId        String       @db.VarChar(32)
  description   String
  status        ReviewStatus @default(Pending)
  adminResponse String?
  reportDate    DateTime     @default(now())
  resolvedDate  DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UpdatePost {
  id          String    @id @default(cuid())
  developerId String    @db.VarChar(32)
  content     String
  postedDate  DateTime  @default(now())
  editedDate  DateTime?
  developer   User      @relation(fields: [developerId], references: [id], onDelete: Cascade)
}

model UpdateIdea {
  id          String   @id @default(cuid())
  userId      String   @db.VarChar(32)
  content     String
  createdDate DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(32)
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushToken {
  token     String   @id
  userId    String   @db.VarChar(32)
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRanksHistory {
  id         String   @id @default(cuid())
  userId     String   @db.VarChar(32)
  oldRank    Rank
  newRank    Rank
  changedBy  String?  @db.VarChar(32)
  actorLabel String?
  changeDate DateTime @default(now())
  user       User     @relation("ChangedUser", fields: [userId], references: [id], onDelete: Cascade)
  actor      User?    @relation("ChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)
}

model LogEvent {
  id          String    @id @default(cuid())
  type        String
  userId      String?
  actionType  String
  details     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  attempts    Int       @default(0)
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ShopProduct {
  key         String   @id
  name        String
  description String
  price       Int
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ProfileDesign {
  id          String               @id @default(cuid())
  name        String
  assetUrl    String
  price       Int
  isLimited   Boolean              @default(false)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  createdById String               @db.VarChar(32)
  createdBy   User                 @relation("ProfileDesignCreator", fields: [createdById], references: [id], onDelete: Cascade)
  owners      OwnedProfileDesign[]
  activeUsers User[]               @relation("ActiveProfileDesign")
}

model OwnedProfileDesign {
  userId      String        @db.VarChar(32)
  designId    String
  purchasedAt DateTime      @default(now())
  pricePaid   Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  design      ProfileDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@id([userId, designId])
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(32)
  amount    Int
  reason    String
  actorId   String?  @db.VarChar(32)
  createdAt DateTime @default(now())
  user      User     @relation("CoinOwner", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?    @relation("CoinActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model RewardInvite {
  id        String    @id @default(cuid())
  buyerId   String    @db.VarChar(32)
  accessKey String    @unique @db.VarChar(64)
  createdAt DateTime  @default(now())
  buyer     User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  access    AccessKey @relation(fields: [accessKey], references: [key], onDelete: Cascade)

  @@index([buyerId, createdAt])
}

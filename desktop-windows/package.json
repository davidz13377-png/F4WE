{
  "name": "f4we-windows",
  "version": "1.3.0",
  "private": true,
  "description": "F4WE desktop music player for Windows",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir --win x64",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^43.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.musicbox.desktop",
    "productName": "F4WE",
    "artifactName": "F4WE-Windows-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "F4WE"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
